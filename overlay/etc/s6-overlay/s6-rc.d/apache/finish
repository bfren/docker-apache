#!/usr/bin/nu

use bf
use bf-apache
use bf-s6
bf env load -x apache

# Terminate container if Apache failed - if we are restarting, do nothing.
# Apache itself is stopped by s6, which sends httpd its down signal (SIGTERM by default)
def main [...args] {
    # if Apache is marked as being restarted, do nothing
    if (bf-apache ctl is_restarting) {
        bf write debug "Apache is restarting, do not terminate container."
        return
    }

    # finish and terminate container
    bf-s6 svc finish --terminate ...$args
}
